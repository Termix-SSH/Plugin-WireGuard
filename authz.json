{
  "$schema": "https://raw.githubusercontent.com/Termix-SSH/Termix/main/scripts/authz/authz.schema.json",
  "seed": [],
  "routes": {
    "POST /plugin-api/wireguard/:hostId/install": {
      "access": "user",
      "permission": "wireguard.use",
      "resource": {
        "kind": "host",
        "min": "connect"
      },
      "destructive": true
    },

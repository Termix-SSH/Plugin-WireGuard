      "access": "user",
      "permission": "wireguard.use",
      "resource": {
        "kind": "host",
        "min": "connect"
      },
      "destructive": true,
      "allowed": "any",
      "note": "Names a iface on the host, which the test host does not have; host access is still checked"
    },
